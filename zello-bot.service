[Unit]
Description=Zello Bot (MSSQL -> Zello)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zello-bot
Group=zello-bot
WorkingDirectory=/opt/zello-bot
Environment=PYTHONUNBUFFERED=1
# Sekrety czyta sam proces (python-dotenv, /opt/zello-bot/.env; chmod 600,
# własność zello-bot). BEZ EnvironmentFile: systemd parsuje backslashe
# inaczej niż python-dotenv, więc "host\instancja" i hasła ze znakami
# specjalnymi byłyby zepsute przed startem Pythona — objaw: MSSQL
# "Login timeout expired" tylko w usłudze, a ręcznie działa.
ExecStart=/opt/zello-bot/.venv/bin/python /opt/zello-bot/main.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
