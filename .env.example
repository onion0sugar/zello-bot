# Zello Bot — konfiguracja. Skopiuj do .env i uzupełnij.
# NIGDY nie umieszczaj prawdziwego .env w repozytorium.
#
# Zapytanie o zamówienia edytujesz w osobnym pliku: query.sql (nie w kodzie!).

# --- MSSQL ---
# Instancja nazwana (bez portu!): 192.168.24.22
# Zwykły adres:                   192.168.24.22  (+ MSSQL_PORT=1433)
MSSQL_SERVER=192.168.1.10
MSSQL_PORT=1433
MSSQL_DATABASE=ERP
MSSQL_USERNAME=zello_bot
MSSQL_PASSWORD=HASLO
# Stary serwer bez TLS 1.2 → ustaw MSSQL_ENCRYPT=no
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# --- Zello Work (wss://zellowork.io/ws/{siec}) -------------------------------
ZELLO_NETWORK=moja_siec
ZELLO_USERNAME=sql_bot
ZELLO_PASSWORD=HASLO
ZELLO_CHANNEL=Magazyn

# --- LUB Zello Friends & Family (darmowe, wss://zello.io/ws) -----------------
# Token z https://developers.zello.com/ (Login → Keys → Add Key →
# "Sample Development Token", ważny 30 dni). Gdy jest ustawiony, ZELLO_NETWORK
# jest ignorowany, a ZELLO_USERNAME / ZELLO_PASSWORD to login do aplikacji Zello.
ZELLO_AUTH_TOKEN=

# --- Zachowanie ---
POLL_INTERVAL=3

# Tylko głos (bez tekstu): SEND_TEXT=false, SEND_VOICE=true
# Tylko tekst: SEND_TEXT=true, SEND_VOICE=false
SEND_TEXT=true
SEND_VOICE=true

VOICE_FILE=audio/new_order.wav
