# Zello Bot — konfiguracja. Skopiuj do .env i uzupełnij.
# NIGDY nie umieszczaj prawdziwego .env w repozytorium.

# --- MSSQL ---
MSSQL_SERVER=192.168.1.10
MSSQL_PORT=1433
MSSQL_DATABASE=ERP
MSSQL_USERNAME=zello_bot
MSSQL_PASSWORD=HASLO

# --- Zello Work ---
ZELLO_NETWORK=moja_siec
ZELLO_USERNAME=sql_bot
ZELLO_PASSWORD=HASLO
ZELLO_CHANNEL=Magazyn

# --- Zachowanie ---
POLL_INTERVAL=3

# Tylko głos (bez tekstu): SEND_TEXT=false, SEND_VOICE=true
# Tylko tekst: SEND_TEXT=true, SEND_VOICE=false
SEND_TEXT=true
SEND_VOICE=true

VOICE_FILE=audio/new_order.wav
